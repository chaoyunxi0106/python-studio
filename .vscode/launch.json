{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: start studio server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/studio.py",
      "args": [
        "serve",
        "--port",
        "8765"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}

